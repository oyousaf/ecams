# Resend API key. Without it, quote requests are only logged (dev) or show a "please call" message (prod).
RESEND_API_KEY=
# Where quote/booking requests are sent, and the verified sender.
QUOTE_TO=alex@ecamservices.co.uk
QUOTE_FROM="ECAMS website <quotes@legxcysol.dev>"
# Canonical URL, and whether search engines may index the site (only once it's on ecamservices.com).
NEXT_PUBLIC_SITE_URL=https://ecams.legxcysol.dev
NEXT_PUBLIC_INDEXABLE=false
